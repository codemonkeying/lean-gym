# leangym - only CODE, tests, docs and deploy templates are tracked.
# Machine state (results, queues, logs, backups, models) lives in the working tree only.

# --- run state / outputs ---
results/
results_think_on/
sandbox_results/
runs/
backups/
history/
_historical_archive_bad_harness/
archive_prelean/
queue.json
queue.json.*
*.bak
*.bak-*

# --- logs ---
*.log
*.out
*.err
err.txt
rc1_*_retest.json
train/*.log

# --- per-machine deploy state (generated by deploy/install.sh) ---
deploy/generated/
deploy/*.env
!deploy/templates/*.env
deploy/.installed

# --- local config (copy leangym.toml.example) ---
leangym.toml

# --- dev worktree (branch 'dev'): our testing/tweaking sandbox, never tracked by main ---
/dev/

# --- python / editor ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.swp
.DS_Store
results_kilo/
results_plan/

# --- internal, never-ship trees (local research/notes/scaffolding) ---
# Internal dev notes, handovers, design backlog, strategy - never public.
docs/notes/
# Training/distillation pipeline - local research, not shipped.
train/
tests/test_from_capture.py
# Manual/live test scaffolding (hardcodes infra, needs a running router).
tests/manual/
# Repo-generation scenarios - internal task-authoring scratch - EXCEPT the shipped
# fixtures under scenarios/repo/ that the repo suite needs at runtime.
scenarios/*
!scenarios/repo/
# Plan-provider quota logger - site-specific, reads OAuth tokens, not shipped.
tools/plan_usage_log.py

# --- private name/word lists for the hygiene sweep (never committed) ---
tests/.private_names
tests/.private_words

# --- local-only ops scripts (untracked 2026-10-22, decision 8a) ---
local/
.gym/
